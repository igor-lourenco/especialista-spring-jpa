<?xml version="1.0" encoding="UTF-8"?>
<entity-mappings
        xmlns="http://xmlns.jcp.org/xml/ns/persistence/orm"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/persistence/orm http://xmlns.jcp.org/xml/ns/persistence/orm_2_2.xsd"
        version="2.2">

    <!-- ===== Por padrao o arquivo orm.xml nao precisa ser especificado ===== -->

    <!--============================================================================================    -->
    <!--================================ NAMED QUERY ===============================================    -->

    <named-query name="Pedido.findAllPedidosArquivoXML"> <!-- Consulta NamedQuery com JPQL -->
        <query>
            SELECT p FROM Pedido p
            LEFT JOIN FETCH p.pagamento
            JOIN FETCH p.cliente c
            LEFT JOIN FETCH c.contatos con
            LEFT JOIN FETCH p.notaFiscal
            JOIN FETCH p.itensPedido itens
            JOIN FETCH itens.produto prod
            LEFT JOIN FETCH prod.estoque
        </query>
    </named-query>

    <!--==================================================================================================    -->
    <!--================================ NAMED NATIVE QUERY ===============================================    -->

    <named-native-query name="tb_categoria.buscarTodos" result-set-mapping="tb_categoria.Categoria">
        <query>SELECT * FROM tb_categoria</query>
    </named-native-query>

    <named-native-query name="tb_categoria.buscarTodos.CategoriaDTO" result-set-mapping="tb_categoria.CategoriaDTO">
        <query>SELECT id, nome FROM tb_categoria ORDER BY id ASC </query>
    </named-native-query>

    <!--=====================================================================================================    -->

    <!-- Nao precisa mapear os campos da entidade, esse serve apenas de exemplo -->
    <sql-result-set-mapping name="tb_categoria.Categoria">
        <entity-result entity-class="com.especialista.spring.jpa.entities.Categoria">
            <field-result name="id" column="id"/>  <!-- tem que ser na ordem do construtor da Categoria -->
            <field-result name="nome" column="nome"/>
            <field-result name="categoriaPai" column="categoria_pai_id"/>
        </entity-result>
    </sql-result-set-mapping>


    <!-- Mapeando as colunas da tabela tb_categoria para a classe CategoriaDTO -->
    <sql-result-set-mapping name="tb_categoria.CategoriaDTO">
        <constructor-result target-class="com.especialista.spring.jpa.DTOs.CategoriaDTO">
            <column name="id" />  <!-- tem que ser na ordem do construtor da CategoriaDTO -->
            <column name="nome" />
        </constructor-result>
    </sql-result-set-mapping>

</entity-mappings>